# Compose interpolation 입력이다. ASP.NET이 .env 파일을 자동으로 읽는 것은 아니다.
DOTNET_ENVIRONMENT=Development
ASPNETCORE_ENVIRONMENT=Development
CHAT_API_PORT=5085
CHAT_ALLOWED_HOSTS=localhost;127.0.0.1
CHAT_BROWSER_ORIGIN=
CHAT_REDIS_NAMESPACE=translacat:chat:development
# 실제 BE/DB 정책을 확인한 값과 저장소 밖 또는 ignored .secrets/development의 파일 경로를 채운다.
CHAT_SOURCE_TIME_ZONE=
CHAT_REDIS_PASSWORD_FILE=
CHAT_DATABASE_CONNECTION_FILE=
CHAT_JWT_SIGNING_KEY_FILE=

# 선택 compose.internal-auth.yaml 입력. 양쪽 계약 검증 전 모든 새 연결을 비활성으로 둔다.
CHAT_SERVICE_INGRESS_ENABLED=false
CHAT_SERVICE_INGRESS_ISSUER=
CHAT_SERVICE_INGRESS_AUDIENCE=
CHAT_SERVICE_INGRESS_SERVICE=
CHAT_SERVICE_INGRESS_KEY_FILE=
CHAT_IDENTITY_ENABLED=false
CHAT_IDENTITY_BASE_URL=
CHAT_IDENTITY_TIMEOUT_SECONDS=5
CHAT_IDENTITY_ISSUER=
CHAT_IDENTITY_AUDIENCE=
CHAT_IDENTITY_SERVICE=
CHAT_IDENTITY_KEY_FILE=
CHAT_CORE_ENABLED=false
CHAT_CORE_BASE_URL=
CHAT_CORE_TIMEOUT_SECONDS=5
CHAT_CORE_ISSUER=
CHAT_CORE_AUDIENCE=
CHAT_CORE_SERVICE=
CHAT_AI_ENABLED=false
CHAT_TRANSLATION_ENABLED=false
CHAT_AI_BASE_URL=
CHAT_AI_API_KEY_FILE=
