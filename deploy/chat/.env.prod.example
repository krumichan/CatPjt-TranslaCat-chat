# OCI host의 deploy/chat/.env에 복사해 운영별 실제 값을 공급한다. .NET은 이 파일을 직접 읽지 않는다.
# docker compose --env-file이 읽고 compose.yaml/internal-auth.yaml이 컨테이너 설정으로 전달한다.
DOTNET_ENVIRONMENT=Production
ASPNETCORE_ENVIRONMENT=Production
CHAT_API_PORT=5085
CHAT_ALLOWED_HOSTS=
CHAT_BROWSER_ORIGIN=
CHAT_REDIS_NAMESPACE=translacat:chat:Production
CHAT_SOURCE_TIME_ZONE=
CHAT_REDIS_PASSWORD_FILE=
CHAT_DATABASE_CONNECTION_FILE=
CHAT_JWT_SIGNING_KEY_FILE=

# BE→CHAT: BE chat.gateway의 issuer/audience/service와 같은 고정 계약이다.
CHAT_SERVICE_INGRESS_ISSUER=translacat-be
CHAT_SERVICE_INGRESS_AUDIENCE=translacat-chat
CHAT_SERVICE_INGRESS_SERVICE=translacat-be
CHAT_SERVICE_INGRESS_KEY_FILE=

# CHAT→BE: Identity와 Core가 한 호출 방향의 별도 서비스 키를 사용한다.
CHAT_IDENTITY_BASE_URL=
CHAT_IDENTITY_TIMEOUT_SECONDS=5
CHAT_IDENTITY_ISSUER=translacat-chat
CHAT_IDENTITY_AUDIENCE=translacat-be
CHAT_IDENTITY_SERVICE=translacat-chat
CHAT_IDENTITY_KEY_FILE=
CHAT_CORE_BASE_URL=
CHAT_CORE_TIMEOUT_SECONDS=5
CHAT_CORE_ISSUER=translacat-chat
CHAT_CORE_AUDIENCE=translacat-be
CHAT_CORE_SERVICE=translacat-chat

# CHAT→AI: AI의 CHAT_SERVER_API_KEY와 동일한 CHAT 전용 opaque 원본을 공급한다.
CHAT_AI_BASE_URL=
CHAT_AI_API_KEY_FILE=
